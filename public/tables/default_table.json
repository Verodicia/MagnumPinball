        "sublabel": "SHOOT AGAIN"
      }
    }
  ],
  "splines": [
    {
      "id": "left_ramp",
      "kind": "ramp",
      "layer": 1,
      "width": 6,
      "snapStart": "ramp_entry.out",
      "segments": [
        [
          [14, 52, 0],
          [14, 68, 2],
          [18, 82, 8],
          [30, 92, 8]
        ]
      ]
    }
  ],
  "rules": {
    "ballsPerGame": 3,
    "initialState": "BaseMode",
    "vars": {
      "locks_lit": false,
      "jackpots": 0
    },
    "states": {
      "BaseMode": {
        "label": "BASE MODE"
      },
      "SkillShotActive": {
        "label": "SKILL SHOT",
        "timer": 8,
        "next": "BaseMode"
      },
      "JackpotFrenzy": {
        "label": "JACKPOT FRENZY",
        "timer": 20,
        "next": "BaseMode"
      },
      "MultiballReady": {
        "label": "MULTIBALL READY"
      }
    },
    "rules": [
      {
        "id": "ball_start",
        "when": {
          "event": "ON_BALL_START"
        },
        "do": [
          {
            "type": "SET_STATE",
            "state": "SkillShotActive"
          },
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_a",
            "pattern": "OFF"
          },
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_b",
            "pattern": "OFF"
          },
          {
            "type": "SHOW_TEXT",
            "text": "SKILL SHOT - SHOOT THE RAMP",
            "seconds": 3
          }
        ]
      },
      {
        "id": "skill_shot",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "left_ramp.entry"
        },
        "if": [
          {
            "lhs": "state",
            "op": "==",
            "rhs": "SkillShotActive"
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 50000
          },
          {
            "type": "SHOW_TEXT",
            "text": "SKILL SHOT!",
            "seconds": 3
          },
          {
            "type": "SET_STATE",
            "state": "BaseMode"
          },
          {
            "type": "PLAY_SFX",
            "sfx": "jackpot_lit"
          }
        ]
      },
      {
        "id": "pop_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "pop_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 1000
          },
          {
            "type": "PLAY_SFX",
            "sfx": "bumper"
          }
        ]
      },
      {
        "id": "sling_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "sling_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 500
          },
          {
            "type": "PLAY_SFX",
            "sfx": "sling"
          }
        ]
      },
      {
        "id": "inlane_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "inlane_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 2500
          },
          {
            "type": "PLAY_SFX",
            "sfx": "rollover"
          }
        ]
      },
      {
        "id": "outlane_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "outlane_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 3500
          },
          {
            "type": "PLAY_SFX",
            "sfx": "rollover"
          }
        ]
      },
      {
        "id": "top_lane_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "top_lane_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 3000
          },
          {
            "type": "PLAY_SFX",
            "sfx": "rollover"
          }
        ]
      },
      {
        "id": "standup_target_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "*_target_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 2000
          },
          {
            "type": "PLAY_SFX",
            "sfx": "target"
          }
        ]
      },
      {
        "id": "spinner_score",
        "when": {
          "event": "ON_SPINNER_SPIN",
          "id": "spinner_arch"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 750
          },
          {
            "type": "PLAY_SFX",
            "sfx": "spinner"
          }
        ]
      },
      {
        "id": "drop_target_score",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "drop_bank_alpha_*"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 1000
          },
          {
            "type": "PLAY_SFX",
            "sfx": "target"
          }
        ]
      },
      {
        "id": "bank_complete_lock_already_lit",
        "when": {
          "event": "ON_TARGET_BANK_COMPLETE",
          "id": "drop_bank_alpha"
        },
        "if": [
          {
            "lhs": "var.locks_lit",
            "op": "==",
            "rhs": true
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 10000
          },
          {
            "type": "FIRE_SOLENOID",
            "module": "drop_bank_alpha",
            "port": "reset"
          }
        ]
      },
      {
        "id": "bank_complete_light_lock",
        "when": {
          "event": "ON_TARGET_BANK_COMPLETE",
          "id": "drop_bank_alpha"
        },
        "if": [
          {
            "lhs": "state",
            "op": "==",
            "rhs": "BaseMode"
          },
          {
            "lhs": "var.locks_lit",
            "op": "==",
            "rhs": false
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 25000
          },
          {
            "type": "SET_VAR",
            "name": "locks_lit",
            "value": true
          },
          {
            "type": "SET_LAMP",
            "lamp": "ramp_arrow",
            "pattern": "BLINK_FAST",
            "color": "#00FF88"
          },
          {
            "type": "PLAY_SFX",
            "sfx": "jackpot_lit"
          },
          {
            "type": "SHOW_TEXT",
            "text": "LOCK IS LIT",
            "seconds": 3
          },
          {
            "type": "FIRE_SOLENOID",
            "module": "drop_bank_alpha",
            "port": "reset"
          }
        ]
      },
      {
        "id": "bank_complete_other_mode",
        "when": {
          "event": "ON_TARGET_BANK_COMPLETE",
          "id": "drop_bank_alpha"
        },
        "if": [
          {
            "lhs": "state",
            "op": "!=",
            "rhs": "BaseMode"
          },
          {
            "lhs": "var.locks_lit",
            "op": "==",
            "rhs": false
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 10000
          },
          {
            "type": "FIRE_SOLENOID",
            "module": "drop_bank_alpha",
            "port": "reset"
          }
        ]
      },
      {
        "id": "ramp_jackpot_in_frenzy",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "left_ramp.exit"
        },
        "if": [
          {
            "lhs": "state",
            "op": "==",
            "rhs": "JackpotFrenzy"
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 100000
          },
          {
            "type": "SHOW_TEXT",
            "text": "JACKPOT!",
            "seconds": 2
          },
          {
            "type": "PLAY_SFX",
            "sfx": "jackpot_lit"
          }
        ]
      },
      {
        "id": "ramp_start_frenzy",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "left_ramp.exit"
        },
        "if": [
          {
            "lhs": "var.locks_lit",
            "op": "==",
            "rhs": true
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 50000
          },
          {
            "type": "SET_VAR",
            "name": "locks_lit",
            "value": false
          },
          {
            "type": "ADD_VAR",
            "name": "jackpots",
            "delta": 1
          },
          {
            "type": "SET_STATE",
            "state": "JackpotFrenzy"
          },
          {
            "type": "SET_LAMP",
            "lamp": "ramp_arrow",
            "pattern": "OFF"
          },
          {
            "type": "SHOW_TEXT",
            "text": "JACKPOT FRENZY",
            "seconds": 3
          },
          {
            "type": "PLAY_SFX",
            "sfx": "jackpot_lit"
          }
        ]
      },
      {
        "id": "ramp_basic",
        "when": {
          "event": "ON_SWITCH_HIT",
          "id": "left_ramp.exit"
        },
        "if": [
          {
            "lhs": "state",
            "op": "==",
            "rhs": "BaseMode"
          },
          {
            "lhs": "var.locks_lit",
            "op": "==",
            "rhs": false
          }
        ],
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 5000
          },
          {
            "type": "PLAY_SFX",
            "sfx": "ramp"
          }
        ]
      },
      {
        "id": "frenzy_lamps_on",
        "when": {
          "event": "ON_STATE_ENTER",
          "id": "JackpotFrenzy"
        },
        "do": [
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_a",
            "pattern": "BLINK_FAST",
            "color": "#FF3366"
          },
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_b",
            "pattern": "BLINK_FAST",
            "color": "#FF3366"
          }
        ]
      },
      {
        "id": "frenzy_lamps_off",
        "when": {
          "event": "ON_STATE_ENTER",
          "id": "BaseMode"
        },
        "do": [
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_a",
            "pattern": "OFF"
          },
          {
            "type": "SET_LAMP",
            "lamp": "frenzy_lamp_b",
            "pattern": "OFF"
          }
        ]
      },
      {
        "id": "scoop_locked",
        "when": {
          "event": "ON_BALL_LOCKED",
          "id": "lock_scoop"
        },
        "do": [
          {
            "type": "ADD_SCORE",
            "points": 5000
          },
          {
            "type": "SHOW_TEXT",
            "text": "BALL LOCKED",
            "seconds": 2
          },
          {
            "type": "PLAY_SFX",
            "sfx": "jackpot_lit"
          }
        ]
      },
      {
        "id": "tilt_text",
        "when": {
          "event": "ON_TILT"
        },
        "do": [
          {
            "type": "SHOW_TEXT",
            "text": "TILT",
            "seconds": 5
          },
          {
            "type": "PLAY_SFX",
            "sfx": "tilt"
          }
        ]
      }
    ]
  }
}
